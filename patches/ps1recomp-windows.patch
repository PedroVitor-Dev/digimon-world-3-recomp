+#pragma once
+#ifdef _WIN32
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <cstdio>
+#include <io.h>
+#include <cstdlib>
+inline int backtrace(void** frames, int count) {
+  return static_cast<int>(CaptureStackBackTrace(0, static_cast<DWORD>(count), frames, nullptr));
+}
+inline char** backtrace_symbols(void* const* frames, int count) {
+  if (count <= 0) return nullptr;
+  auto* block = static_cast<char**>(std::malloc(static_cast<size_t>(count) * (sizeof(char*) + 32)));
+  if (!block) return nullptr;
+  auto* text = reinterpret_cast<char*>(block + count);
+  for (int i = 0; i < count; ++i) {
+    block[i] = text + i * 32;
+    std::snprintf(block[i], 32, "%p", frames[i]);
+  }
+  return block;
+}
+inline void backtrace_symbols_fd(void* const* frames, int count, int fd) {
+  for (int i = 0; i < count; ++i) {
+    char line[40];
+    int n = std::snprintf(line, sizeof(line), "%p\n", frames[i]);
+    if (n > 0) _write(fd, line, static_cast<unsigned>(n));
+  }
+}
+#else
+#include <execinfo.h>
+#endif
